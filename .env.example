# Talamala local / runtime (copy to .env — never commit secrets)

# local | staging | production
TALAMALA_ENV=local

# SQLite path; omit or :memory: for process-local smoke
# TALAMALA_DB_PATH=var/talamala.sqlite

# JSON-line structured log file (optional)
# TALAMALA_LOG_PATH=var/talamala.log

# Comma-separated browser origins allowed for CORS (empty = deny all AC AO)
# TALAMALA_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Soft log rotate threshold in bytes (default 5000000)
# TALAMALA_LOG_MAX_BYTES=5000000

# Optional short SHA shown on landing hub
# TALAMALA_BUILD_SHA=

# --- Kimia (Verification / Read) — never commit real secrets ---
# KIMIA_BASE_URL=https://kimia-host.example
# KIMIA_USERNAME=
# KIMIA_PASSWORD=
# KIMIA_SWAGGER_URL=   # optional override
# KIMIA_WRITE_VERIFY_ENABLE=0
# KIMIA_WRITE_ACCOUNT_ALLOWLIST=350

# === PRODUCTION CHECKLIST (Phase-1 pilot) ===
# TALAMALA_ENV=production
# TALAMALA_CORS_ORIGINS=https://app.example.com
# TALAMALA_DB_PATH=/var/lib/talamala/talamala.sqlite
# KIMIA_WRITE_VERIFY_ENABLE=0
# Never enable write flags without Owner-authorized session on Iran runner
