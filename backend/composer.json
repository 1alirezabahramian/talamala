{
  "name": "talamala/backend",
  "description": "Talamala backend — Complex Backend, Simple Frontend",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "guzzlehttp/guzzle": "^7.8",
    "ramsey/uuid": "^4.7",
    "brick/math": "^0.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Talamala\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Talamala\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
