# Talamala Phase-1 PILOT template — copy to .env on the pilot Host
# NEVER commit real secrets. NEVER enable Write without new Owner authorization.

TALAMALA_ENV=production

# Exact browser origins for Customer + Backoffice SPA (comma-separated)
TALAMALA_CORS_ORIGINS=https://app.example.com

# Durable SQLite (or future DSN). Prefer absolute path on Host.
TALAMALA_DB_PATH=/var/lib/talamala/talamala.sqlite

# Optional structured log
# TALAMALA_LOG_PATH=/var/log/talamala/talamala.log
# TALAMALA_LOG_MAX_BYTES=5000000

# Optional short SHA on landing
# TALAMALA_BUILD_SHA=

# --- Kimia READ only for pilot ---
# KIMIA_BASE_URL=https://kimia-host.example
# KIMIA_USERNAME=
# KIMIA_PASSWORD=
# KIMIA_SWAGGER_URL=

# HARD DENY for Phase-1 pilot (do not flip without Owner session on Iran runner)
KIMIA_WRITE_VERIFY_ENABLE=0
# KIMIA_WRITE_ACCOUNT_ALLOWLIST=350
